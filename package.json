{
  "name": "nanotype",
  "version": "1.1.0",
  "description": "Nanotype: a free, minimal, private online text editor",
  "scripts": {
    "build": "NODE_ENV=production gulp default",
    "dev": "NODE_ENV=development gulp dev",
    "test": "node --test test/share.test.mjs test/markdown.test.mjs test/names.test.mjs test/tidy.test.mjs test/seo.test.mjs",
    "test:browser": "node test/browser/run.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nazdash/nanotype.git"
  },
  "author": "Nazir Dashtiev",
  "license": "AGPL-3.0-only",
  "homepage": "https://nanotype.app/",
